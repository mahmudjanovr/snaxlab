---
const pageTitle = 'SnaxLab Admin'
---

<!doctype html>
<html lang="uz" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{pageTitle}</title>
    <script>
      const savedTheme = localStorage.getItem('snaxlab-admin-theme')
      const prefersLight = window.matchMedia(
        '(prefers-color-scheme: light)',
      ).matches
      document.documentElement.dataset.theme =
        savedTheme || (prefersLight ? 'light' : 'dark')
    </script>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-mark">
            <img src="/static/logo.svg" alt="SnaxLab logo" />
          </div>
          <div>
            <p class="eyebrow">SnaxLab</p>
            <h1>Admin</h1>
          </div>
        </div>

        <nav class="nav" aria-label="Admin sections">
          <a class="nav-item active" href="#editor">Editor</a>
          <a class="nav-item" href="#manager">Maqolalar</a>
          <a class="nav-item" href="#preview">Preview</a>
          <a class="nav-item" href="#publish">Publish</a>
        </nav>

        <div class="status-card">
          <span class="pulse"></span>
          <div>
            <strong>Static CMS mode</strong>
            <p>
              Creates MDX posts in GitHub through a private Cloudflare Pages
              Function.
            </p>
          </div>
        </div>
      </aside>

      <main class="workspace">
        <section class="hero">
          <div>
            <h2>Create and publish "SnaxLab" posts.</h2>
          </div>
          <div class="hero-actions">
            <button
              class="theme-toggle"
              id="themeToggle"
              type="button"
              aria-label="Switch theme"
            >
              <span class="theme-label">Theme</span>
              <span class="theme-switch" aria-hidden="true"></span>
              <span class="theme-value">Light</span>
            </button>
            <button class="ghost" id="loadDraftBtn" type="button"
              >Load draft</button
            >
            <button class="danger" id="clearBtn" type="button">Clear</button>
          </div>
        </section>

        <section class="grid">

        <section class="panel manager" id="manager" style="display:none;">
          <div class="panel-head">
            <div>
              <p class="eyebrow">GitHub repozitoriy</p>
              <h3>Mavjud maqolalar</h3>
            </div>
            <button class="ghost" id="refreshPostsBtn" type="button">Ro'yxatni yangilash</button>
          </div>
          <p class="message" id="managerStatus">Maqolalarni ko'rish va boshqarish uchun yuqoridagi parolni kiriting va "Ro'yxatni yangilash" tugmasini bosing.</p>
          <div class="posts-table-wrapper" id="postsList"></div>
        </section>

          <form class="panel editor" id="postForm">
            <div id="editingBanner" style="display:none; padding:10px 14px; margin-bottom:12px; background:var(--surface-soft); border:1px solid var(--border-strong); border-radius:var(--radius); display:none; align-items:center; justify-content:space-between; font-size:12px;">
              <span>Tahrirlanmoqda: <strong id="editingFileName"></strong></span>
              <button type="button" class="danger" id="cancelEditBtn" style="padding:4px 8px; font-size:11px;">Bekor qilish</button>
            </div>
            <div class="panel-head" id="editor">
              <div>
                <p class="eyebrow">Article metadata</p>
                <h3>New post</h3>
              </div>
              <span class="badge" id="saveState">Autosave ready</span>
            </div>

            <label>
              <span>Admin password</span>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
              />
            </label>

            <div class="two-cols">
              <label>
                <span>Status</span>
                <select id="draft" name="draft">
                  <option value="false">Publish now</option>
                  <option value="true">Save as draft</option>
                </select>
              </label>
            </div>

            <label>
              <span>Title</span>
              <input id="title" name="title" maxlength="120" required />
            </label>

            <label>
              <span>Description</span>
              <textarea
                id="description"
                name="description"
                class="small-textarea"
                placeholder="Short summary for blog cards"
                maxlength="240"
                required></textarea>
            </label>

            <div class="two-cols">
              <label>
                <span>Slug</span>
                <input id="slug" name="slug" placeholder="auto-generated" />
              </label>

              <label>
                <span>Tags</span>
                <input
                  id="tags"
                  name="tags"
                  placeholder="books, philosophy, coding"
                />
              </label>
            </div>

            <label>
              <span>Author</span>
              <input
                id="author"
                name="author"
                value="snaxcyz"
                placeholder="snaxcyz"
              />
            </label>

            <label>
              <span>Article body</span>
              <textarea
                id="body"
                name="body"
                class="body-editor"
                placeholder="# Start writing here..."
                required></textarea>
            </label>

            <div class="toolbar" id="publish">
              <button class="primary" type="submit">Publish to SnaxLab</button>
              <button class="ghost" id="copyMdxBtn" type="button"
                >Copy MDX</button
              >
            </div>

            <p class="message" id="message" role="status"></p>
          </form>

          <section class="panel preview" id="preview">
            <div class="panel-head">
              <div>
                <p class="eyebrow">Live output</p>
                <h3>Preview</h3>
              </div>
              <span class="badge" id="wordCount">0 words</span>
            </div>

            <div class="preview-card">
              <div class="preview-meta">
                <span id="previewLang">UZ</span>
                <span id="previewDate"></span>
              </div>
              <h4 id="previewTitle">Your title will appear here</h4>
              <p id="previewDescription">
                Your description preview will appear here.
              </p>
              <div class="tag-list" id="previewTags"></div>
            </div>

            <div class="mdx-box">
              <div class="mdx-head">
                <span>Generated MDX</span>
                <code id="fileName">src/content/blog/post.mdx</code>
              </div>
              <pre id="mdxPreview"></pre>
            </div>
          </section>
        </section>
      </main>
    </div>

    <script>
      // @ts-nocheck
      const form = document.querySelector('#postForm')
      const fields = {
        password: document.querySelector('#password'),
        title: document.querySelector('#title'),
        description: document.querySelector('#description'),
        draft: document.querySelector('#draft'),
        slug: document.querySelector('#slug'),
        tags: document.querySelector('#tags'),
        author: document.querySelector('#author'),
        body: document.querySelector('#body'),
      }

      const message = document.querySelector('#message')
      const saveState = document.querySelector('#saveState')
      const previewTitle = document.querySelector('#previewTitle')
      const previewDescription = document.querySelector('#previewDescription')
      const previewTags = document.querySelector('#previewTags')
      const previewLang = document.querySelector('#previewLang')
      const previewDate = document.querySelector('#previewDate')
      const wordCount = document.querySelector('#wordCount')
      const mdxPreview = document.querySelector('#mdxPreview')
      const fileName = document.querySelector('#fileName')
      const clearBtn = document.querySelector('#clearBtn')
      const loadDraftBtn = document.querySelector('#loadDraftBtn')
      const copyMdxBtn = document.querySelector('#copyMdxBtn')
      const themeToggle = document.querySelector('#themeToggle')
      const themeValue = themeToggle.querySelector('.theme-value')

      const STORAGE_KEY = 'snaxlab-admin-draft-v1'
      const THEME_KEY = 'snaxlab-admin-theme'
      const PUBLISH_ERRORS = {
        400: 'Invalid request.',
        401: 'Wrong admin password.',
        409: 'A post with this slug already exists. Choose another slug.',
        413: 'Article is too large.',
        500: 'Server error. Try again later.',
      }

      let publishing = false

      function setTheme(theme) {
        document.documentElement.dataset.theme = theme
        localStorage.setItem(THEME_KEY, theme)
        themeValue.textContent = theme === 'dark' ? 'Light' : 'Dark'
        themeToggle.setAttribute('aria-pressed', theme === 'light')
        themeToggle.setAttribute(
          'aria-label',
          `Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`,
        )
      }

      function slugify(value) {
        const slug = String(value || '')
          .toLowerCase()
          .trim()
          .replace(/['\u2019]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .replace(/-uz$/, '')
          .slice(0, 80)
          .replace(/-+$/g, '')

        return slug || 'untitled-post'
      }

      function splitList(value) {
        return String(value || '')
          .split(',')
          .map((item) => item.trim())
          .filter(Boolean)
      }

      function yamlString(value) {
        return JSON.stringify(String(value || ''))
      }

      function today() {
        return new Date().toISOString().slice(0, 10)
      }

      function getArticleData() {
        const title = fields.title.value.trim()
        const autoSlug = slugify(title || 'untitled-post')
        const slug = slugify(fields.slug.value || autoSlug)

        return {
          title,
          description: fields.description.value.trim(),
          lang: 'uz',
          draft: fields.draft.value === 'true',
          slug,
          tags: splitList(fields.tags?.value),
          author: (fields.author?.value || 'snaxcyz').trim(),
          body: fields.body.value.trim(),
        }
      }

      function getData() {
        return {
          ...getArticleData(),
          password: fields.password.value,
        }
      }

      function makeMdx(data) {
        const draftLine = data.draft ? 'draft: true\n' : ''
        return `---
title: ${yamlString(data.title)}
description: ${yamlString(data.description)}
date: ${yamlString(today())}
lang: ${yamlString(data.lang)}
tags: ${JSON.stringify(data.tags)}
author: ${JSON.stringify(data.author || 'snaxcyz')}
${draftLine}---

${data.body}
`
      }

      function isSafeCommitUrl(url) {
        try {
          const parsed = new URL(url)
          return parsed.protocol === 'https:' && parsed.hostname === 'github.com'
        } catch {
          return false
        }
      }

      function setMessage(text, type) {
        message.replaceChildren()
        message.className = type ? `message ${type}` : 'message'
        message.textContent = text
      }

      function showPublishSuccess(commitUrl) {
        message.replaceChildren()
        message.className = 'message success'
        message.appendChild(document.createTextNode('Published successfully'))

        if (!isSafeCommitUrl(commitUrl)) return

        message.appendChild(document.createTextNode(' — '))
        const link = document.createElement('a')
        link.href = commitUrl
        link.target = '_blank'
        link.rel = 'noreferrer noopener'
        link.textContent = 'view GitHub commit'
        message.appendChild(link)
      }

      function setFormDisabled(disabled) {
        form
          .querySelectorAll('button, input, select, textarea')
          .forEach((control) => {
            control.disabled = disabled
          })
      }

      function updatePreview() {
        const data = getArticleData()
        const mdx = makeMdx(data)

        previewTitle.textContent = data.title || 'Your title will appear here'
        previewDescription.textContent =
          data.description || 'Your description preview will appear here.'
        previewLang.textContent = 'UZ'
        previewDate.textContent = today()
        fileName.textContent = `src/content/blog/${data.slug}-uz.mdx`
        mdxPreview.textContent = mdx

        const words = data.body
          ? data.body.split(/\s+/).filter(Boolean).length
          : 0
        wordCount.textContent = `${words} word${words === 1 ? '' : 's'}`

        previewTags.replaceChildren()
        ;(data.tags.length ? data.tags : ['no tags yet']).forEach((tag) => {
          const el = document.createElement('span')
          el.textContent = tag
          previewTags.appendChild(el)
        })
      }

      function saveDraft() {
        const draft = getArticleData()
        localStorage.setItem(STORAGE_KEY, JSON.stringify(draft))
        saveState.textContent = 'Autosaved'
        window.setTimeout(() => (saveState.textContent = 'Autosave ready'), 900)
      }

      function loadDraft() {
        const raw = localStorage.getItem(STORAGE_KEY)
        if (!raw) {
          setMessage('No saved draft found.')
          return
        }

        try {
          const data = JSON.parse(raw)
          const keys = [
            'title',
            'description',
            'draft',
            'slug',
            'tags',
            'author',
            'body',
          ]

          keys.forEach((key) => {
            if (!fields[key]) return
            const value = data[key] ?? (key === 'author' ? data.authors : undefined)
            if (value == null) return
            fields[key].value = Array.isArray(value)
              ? value.join(', ')
              : String(value)
          })

          if (data.slug) fields.slug.dataset.touched = 'true'
          setMessage('Draft loaded.', 'success')
          updatePreview()
        } catch {
          setMessage('Saved draft is invalid.', 'error')
        }
      }

      Object.entries(fields).forEach(([name, field]) => {
        if (!field) return

        const onChange = () => {
          if (name === 'title' && !fields.slug.dataset.touched) {
            fields.slug.value = slugify(fields.title.value)
          }
          updatePreview()
          if (name !== 'password') saveDraft()
        }

        field.addEventListener('input', onChange)
        if (name === 'draft') field.addEventListener('change', onChange)
      })

      fields.slug.addEventListener('input', () => {
        fields.slug.dataset.touched = 'true'
      })

      clearBtn.addEventListener('click', () => {
        form.reset()
        fields.author.value = 'snaxcyz'
        fields.slug.dataset.touched = ''
        localStorage.removeItem(STORAGE_KEY)
        setMessage('Editor cleared.')
        updatePreview()
      })

      loadDraftBtn.addEventListener('click', loadDraft)

      copyMdxBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(makeMdx(getArticleData()))
          setMessage('MDX copied to clipboard.', 'success')
        } catch {
          setMessage('Clipboard access is unavailable in this browser.', 'error')
        }
      })

      themeToggle.addEventListener('click', () => {
        setTheme(
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark',
        )
      })

      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        if (publishing) return

        publishing = true
        const submitBtn = form.querySelector('button[type="submit"]')
        const originalSubmitText = submitBtn ? submitBtn.textContent : ''
        setMessage('Publishing...')
        if (submitBtn) submitBtn.textContent = 'Publishing...'
        form.classList.add('is-loading')
        setFormDisabled(true)

        try {
          const res = await fetch('/api/create-post', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(currentEditing ? { ...getData(), action: 'update', path: currentEditing.path, sha: currentEditing.sha, content: makeMdx(getArticleData()) } : getData()),
          })

          const result = await res.json().catch(() => ({}))

          if (!res.ok) {
            throw new Error(
              result.error ||
                PUBLISH_ERRORS[res.status] ||
                `Publish failed (${res.status})`,
            )
          }

          showPublishSuccess(result.commitUrl)
          localStorage.removeItem(STORAGE_KEY)
        } catch (error) {
          setMessage(error.message || 'Publish failed.', 'error')
        } finally {
          publishing = false
          form.classList.remove('is-loading')
          setFormDisabled(false)
          if (submitBtn) submitBtn.textContent = originalSubmitText
        }
      })

      const navItems = document.querySelectorAll('.nav-item')
      
      function updateActiveNav(hash) {
        const targetHash = hash || window.location.hash || '#editor'
        navItems.forEach((item) => {
          item.classList.toggle('active', item.getAttribute('href') === targetHash)
        })
        if (managerPanel) {
          managerPanel.style.display = targetHash === '#manager' ? 'block' : 'none'
        }
        const editorForm = document.getElementById('postForm')
        const previewSec = document.getElementById('preview')
        if (targetHash === '#manager') {
          if (editorForm) editorForm.style.display = 'none'
          if (previewSec) previewSec.style.display = 'none'
        } else {
          if (editorForm) editorForm.style.display = ''
          if (previewSec) previewSec.style.display = ''
        }
      }


      
      let currentEditing = null
      const managerPanel = document.getElementById('manager')
      const refreshPostsBtn = document.getElementById('refreshPostsBtn')
      const managerStatus = document.getElementById('managerStatus')
      const postsList = document.getElementById('postsList')
      const editingBanner = document.getElementById('editingBanner')
      const editingFileName = document.getElementById('editingFileName')
      const cancelEditBtn = document.getElementById('cancelEditBtn')

      function parseMdxFrontmatter(raw) {
        const match = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/)
        if (!match) return { frontmatter: {}, body: raw }
        const yaml = match[1]
        const body = match[2]
        const fm = {}
        yaml.split(/\r?\n/).forEach((line) => {
          const colonIdx = line.indexOf(':')
          if (colonIdx > -1) {
            const key = line.slice(0, colonIdx).trim()
            let val = line.slice(colonIdx + 1).trim()
            if (val.startsWith('"') && val.endsWith('"')) val = val.slice(1, -1)
            try {
              if (val.startsWith('[') && val.endsWith(']')) val = JSON.parse(val)
            } catch {}
            fm[key] = val
          }
        })
        return { frontmatter: fm, body: body.trim() }
      }

      function cancelEditing() {
        currentEditing = null
        if (editingBanner) editingBanner.style.display = 'none'
        form.reset()
        fields.author.value = 'snaxcyz'
        fields.slug.dataset.touched = ''
        const submitBtn = form.querySelector('button[type="submit"]')
        if (submitBtn) submitBtn.textContent = 'Publish to SnaxLab'
        updatePreview()
      }

      if (cancelEditBtn) cancelEditBtn.addEventListener('click', cancelEditing)

      async function loadPosts() {
        const password = fields.password.value
        if (!password) {
          if (managerStatus) {
            managerStatus.textContent = 'Iltimos, avval parolni kiriting.'
            managerStatus.className = 'message error'
          }
          return
        }
        if (managerStatus) {
          managerStatus.textContent = 'Maqolalar yuklanmoqda...'
          managerStatus.className = 'message'
        }
        try {
          const res = await fetch('/api/create-post', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password, action: 'list' }),
          })
          const data = await res.json()
          if (!res.ok) throw new Error(data.error || 'Yuklashda xatolik')
          renderPostsTable(data.posts || [])
          if (managerStatus) {
            managerStatus.textContent = `Jami ${data.posts.length} ta maqola topildi.`
            managerStatus.className = 'message success'
          }
        } catch (err) {
          if (managerStatus) {
            managerStatus.textContent = err.message
            managerStatus.className = 'message error'
          }
        }
      }

      if (refreshPostsBtn) refreshPostsBtn.addEventListener('click', loadPosts)

      function renderPostsTable(posts) {
        if (!postsList) return
        if (!posts.length) {
          postsList.innerHTML = '<p class="text-xs text-muted">Maqolalar yoq.</p>'
          return
        }
        postsList.innerHTML = `
          <table class="posts-table">
            <thead>
              <tr>
                <th>Fayl nomi</th>
                <th>Hajmi</th>
                <th>Amallar</th>
              </tr>
            </thead>
            <tbody>
              ${posts.map(p => `
                <tr>
                  <td><code>${p.name}</code></td>
                  <td>${Math.round(p.size / 1024 * 10) / 10} kB</td>
                  <td>
                    <div class="action-btns">
                      <button type="button" class="action-btn edit" data-path="${p.path}">Tahrirlash</button>
                      <button type="button" class="action-btn del" data-path="${p.path}" data-sha="${p.sha}">O'chirish</button>
                    </div>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `

        postsList.querySelectorAll('.action-btn.edit').forEach(btn => {
          btn.addEventListener('click', () => editPost(btn.getAttribute('data-path')))
        })
        postsList.querySelectorAll('.action-btn.del').forEach(btn => {
          btn.addEventListener('click', () => deletePost(btn.getAttribute('data-path'), btn.getAttribute('data-sha')))
        })
      }

      async function editPost(filePath) {
        const password = fields.password.value
        if (!password) {
          alert('Iltimos, avval parolni kiriting.')
          return
        }
        try {
          const res = await fetch('/api/create-post', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password, action: 'get', path: filePath }),
          })
          const data = await res.json()
          if (!res.ok) throw new Error(data.error || 'Postni olishda xatolik')
          
          const parsed = parseMdxFrontmatter(data.content)
          currentEditing = { path: data.path, sha: data.sha }

          fields.title.value = parsed.frontmatter.title || ''
          fields.description.value = parsed.frontmatter.description || ''
          fields.draft.value = parsed.frontmatter.draft ? 'true' : 'false'
          fields.slug.value = filePath.replace(/^src\/content\/blog\//, '').replace(/-uz\.mdx$/, '').replace(/\.mdx$/, '')
          fields.slug.dataset.touched = 'true'
          fields.tags.value = Array.isArray(parsed.frontmatter.tags) ? parsed.frontmatter.tags.join(', ') : (parsed.frontmatter.tags || '')
          fields.author.value = parsed.frontmatter.author || 'snaxcyz'
          fields.body.value = parsed.body || ''

          if (editingFileName) editingFileName.textContent = filePath
          if (editingBanner) editingBanner.style.display = 'flex'
          const submitBtn = form.querySelector('button[type="submit"]')
          if (submitBtn) submitBtn.textContent = "O'zgarishlarni saqlash"

          window.location.hash = '#editor'
          updatePreview()
          setMessage(`Tahrirlash rejimi: ${filePath}`, 'success')
        } catch (err) {
          alert(err.message)
        }
      }

      async function deletePost(filePath, sha) {
        const password = fields.password.value
        if (!password) {
          alert('Iltimos, avval parolni kiriting.')
          return
        }
        if (!confirm(`Haqiqatan ham "${filePath}" maqolasini o'chirmoqchimisiz?`)) return

        try {
          const res = await fetch('/api/create-post', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password, action: 'delete', path: filePath, sha }),
          })
          const data = await res.json()
          if (!res.ok) throw new Error(data.error || 'O\'chirishda xatolik')
          alert("Maqola muvaffaqiyatli o'chirildi.")
          loadPosts()
        } catch (err) {
          alert(err.message)
        }
      }


      window.addEventListener('hashchange', () => updateActiveNav())
      navItems.forEach((item) => {
        item.addEventListener('click', () => {
          updateActiveNav(item.getAttribute('href'))
        })
      })

      previewDate.textContent = today()
      setTheme(document.documentElement.dataset.theme || 'dark')
      updateActiveNav()
      updatePreview()
    </script>

    <style>
      @font-face {
        font-family: 'Geist';
        src: url('/fonts/GeistVF.woff2') format('woff2-variations');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Geist Mono';
        src: url('/fonts/GeistMonoVF.woff2') format('woff2-variations');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }

      :root {
        color-scheme: dark;
        --bg: #161616;
        --sidebar-bg: #111111;
        --surface: #1d1d1d;
        --surface-soft: #242424;
        --surface-muted: #2d2d2d;
        --field-bg: #151515;
        --field-focus: #1b1b1b;
        --border: #343434;
        --border-strong: #4b4b4b;
        --text: #f4f4f5;
        --muted: #a1a1aa;
        --soft: #d4d4d8;
        --accent: #f4f4f5;
        --accent-hover: #e4e4e7;
        --accent-text: #111111;
        --danger: #f87171;
        --danger-bg: rgba(248, 113, 113, 0.1);
        --success: #34d399;
        --link: #a7f3d0;
        --code: #e5e7eb;
        --shadow: 0 24px 70px rgba(0, 0, 0, 0.26);
        --radius: 8px;
      }

      [data-theme='light'] {
        color-scheme: light;
        --bg: #f6f6f4;
        --sidebar-bg: #ffffff;
        --surface: #fffefd;
        --surface-soft: #f4f4f2;
        --surface-muted: #e9e9e5;
        --field-bg: #fffefd;
        --field-focus: #ffffff;
        --border: #deded8;
        --border-strong: #c9c9c0;
        --text: #1c1917;
        --muted: #78716c;
        --soft: #44403c;
        --accent: #1c1917;
        --accent-hover: #292524;
        --accent-text: #ffffff;
        --danger: #b91c1c;
        --danger-bg: #fff1f2;
        --success: #047857;
        --link: #0f766e;
        --code: #292524;
        --shadow: 0 18px 50px rgba(28, 25, 23, 0.08);
      }

      html {
        scroll-behavior: smooth;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        background:
          linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.035),
            transparent 260px
          ),
          var(--bg);
        color: var(--text);
        font-family:
          Geist,
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        font-size: 15px;
        line-height: 1.5;
      }

      a {
        color: var(--link);
      }

      .shell {
        display: grid;
        grid-template-columns: 272px minmax(0, 1fr);
        min-height: 100vh;
      }

      .sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        padding: 24px;
        border-right: 1px solid var(--border);
        background: var(--sidebar-bg);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .brand-mark {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface-soft);
      }

      .brand-mark img {
        width: 24px;
        height: 24px;
        display: block;
      }

      .eyebrow {
        margin: 0 0 6px;
        color: var(--muted);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      h4,
      p {
        margin-top: 0;
      }

      h1 {
        margin-bottom: 0;
        font-size: 1rem;
        letter-spacing: 0;
      }

      .nav {
        display: grid;
        gap: 6px;
        margin-top: 34px;
      }

      .nav-item {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 12px;
        border: 1px solid transparent;
        border-radius: 10px;
        color: var(--soft);
        font-size: 0.94rem;
        font-weight: 650;
        text-align: center;
        text-decoration: none;
        transition:
          background 180ms ease,
          border-color 180ms ease,
          color 180ms ease,
          transform 180ms ease;
      }

      .nav-item.active,
      .nav-item:hover {
        border-color: var(--border);
        background: var(--surface);
        color: var(--text);
      }

      .nav-item:hover {
        transform: translateY(-1px);
      }

      .status-card {
        display: flex;
        gap: 12px;
        margin-top: 34px;
        padding: 14px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface);
        color: var(--soft);
      }

      .status-card p {
        margin: 5px 0 0;
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.5;
      }

      .pulse {
        width: 10px;
        height: 10px;
        flex: 0 0 auto;
        margin-top: 5px;
        border-radius: 999px;
        background: var(--success);
        box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.14);
      }

      .workspace {
        width: min(100%, 1480px);
        padding: clamp(18px, 3vw, 34px);
      }

      .hero,
      .panel {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
        animation: admin-fade-in 420ms ease both;
      }

      .hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        padding: clamp(22px, 3vw, 32px);
      }

      .hero h2 {
        max-width: 720px;
        margin-bottom: 12px;
        font-size: clamp(1.8rem, 3.6vw, 3.1rem);
        font-weight: 720;
        line-height: 1.05;
        letter-spacing: 0;
      }

      .hero-copy {
        max-width: 680px;
        margin-bottom: 0;
        color: var(--soft);
        line-height: 1.65;
      }

      .hero-actions,
      .toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .hero-actions {
        align-items: center;
        justify-content: flex-end;
      }

      .grid {
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(340px, 0.88fr);
        gap: 20px;
        margin-top: 24px;
        align-items: start;
      }

      .panel {
        padding: clamp(18px, 2vw, 24px);
      }

      .panel-head {
        display: flex;
        align-items: start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 20px;
      }

      .panel-head h3 {
        margin-bottom: 0;
        font-size: 1.24rem;
        letter-spacing: 0;
      }

      .badge {
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 6px 10px;
        background: var(--surface-soft);
        color: var(--soft);
        font-size: 0.78rem;
        white-space: nowrap;
      }

      form {
        display: grid;
        gap: 14px;
      }

      label {
        display: grid;
        gap: 8px;
        color: var(--soft);
        font-size: 0.9rem;
        font-weight: 680;
      }

      input,
      select,
      textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 10px;
        outline: none;
        background: var(--field-bg);
        color: var(--text);
        padding: 12px 13px;
        font: inherit;
        transition:
          border-color 0.2s ease,
          background 0.2s ease,
          box-shadow 0.2s ease;
      }

      input::placeholder,
      textarea::placeholder {
        color: var(--muted);
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--border-strong);
        background: var(--field-focus);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 10%, transparent);
      }

      textarea {
        resize: vertical;
      }

      .small-textarea {
        min-height: 96px;
      }

      .body-editor {
        min-height: 430px;
        font-family:
          Geist Mono,
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        line-height: 1.7;
      }

      .two-cols {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }

      button {
        border: 1px solid transparent;
        border-radius: 10px;
        padding: 11px 15px;
        color: var(--text);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        transition:
          transform 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease,
          box-shadow 0.2s ease;
      }

      button:hover {
        transform: translateY(-1px);
      }

      .primary {
        background: var(--accent);
        color: var(--accent-text);
        box-shadow: none;
      }

      .primary:hover {
        background: var(--accent-hover);
      }

      .ghost {
        border: 1px solid var(--border);
        background: var(--surface-soft);
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-width: 132px;
        border: 1px solid var(--border);
        background: var(--surface-soft);
        color: var(--text);
        box-shadow: none;
      }

      .theme-label {
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 720;
      }

      .theme-value {
        min-width: 35px;
        text-align: left;
      }

      .theme-switch {
        position: relative;
        width: 38px;
        height: 22px;
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        background: var(--surface-muted);
        transition:
          background 0.2s ease,
          border-color 0.2s ease;
      }

      .theme-switch::after {
        content: '';
        position: absolute;
        top: 3px;
        left: 3px;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        background: var(--text);
        transition: transform 0.2s ease;
      }

      [data-theme='light'] .theme-switch {
        border-color: var(--border-strong);
        background: var(--surface-muted);
      }

      [data-theme='light'] .theme-switch::after {
        transform: translateX(16px);
        background: var(--text);
      }

      .danger {
        border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
        background: var(--danger-bg);
        color: var(--danger);
      }

      .message {
        min-height: 24px;
        margin: 0;
        color: var(--soft);
        font-weight: 700;
        transition: color 0.2s ease;
      }

      .message.error {
        color: var(--danger);
      }

      .message.success {
        color: var(--success);
      }

      #editor,
      #preview,
      #publish {
        scroll-margin-top: 24px;
      }

      .preview {
        position: sticky;
        top: 24px;
      }

      .preview-card {
        padding: 20px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--surface-soft);
      }

      .preview-meta {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 800;
      }

      .preview-card h4 {
        margin: 18px 0 10px;
        font-size: 1.36rem;
        line-height: 1.15;
        letter-spacing: 0;
        overflow-wrap: break-word;
        word-break: break-word;
      }

      .preview-card p {
        color: var(--soft);
        line-height: 1.7;
        overflow-wrap: break-word;
        word-break: break-word;
      }

      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .tag-list span {
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 6px 10px;
        background: var(--surface);
        color: var(--soft);
        font-size: 0.8rem;
        overflow-wrap: anywhere;
      }

      .mdx-box {
        overflow: hidden;
        margin-top: 18px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--field-bg);
      }

      .mdx-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 15px;
        border-bottom: 1px solid var(--border);
        color: var(--soft);
        font-size: 0.82rem;
        font-weight: 800;
      }

      .mdx-head code {
        color: var(--link);
        font-size: 0.78rem;
      }

      pre {
        max-height: 600px;
        margin: 0;
        overflow: auto;
        padding: 18px;
        color: var(--code);
        font-family:
          'Geist Mono',
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 0.82rem;
        line-height: 1.65;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .is-loading {
        opacity: 0.78;
        pointer-events: none;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }

      @keyframes admin-fade-in {
        from {
          opacity: 0;
          transform: translateY(8px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 1120px) {
        .shell {
          grid-template-columns: 1fr;
        }

        .sidebar {
          position: static;
          height: auto;
          border-right: 0;
          border-bottom: 1px solid var(--border);
        }

        .nav {
          grid-template-columns: repeat(3, 1fr);
        }

        .grid {
          grid-template-columns: 1fr;
        }

        .preview {
          position: static;
        }
      }

      @media (max-width: 720px) {
        .workspace,
        .sidebar {
          padding: 16px;
        }

        .status-card {
          margin-top: 18px;
        }

        .hero {
          align-items: stretch;
          flex-direction: column;
          padding: 22px;
        }

        .two-cols {
          grid-template-columns: 1fr;
        }

        .panel {
          padding: 18px;
        }

        .panel-head,
        .mdx-head {
          align-items: flex-start;
          flex-direction: column;
        }

        .hero-actions,
        .toolbar {
          display: grid;
          grid-template-columns: 1fr;
        }

        input,
        select,
        textarea {
          font-size: 16px;
        }

        .body-editor {
          min-height: 320px;
        }

        button,
        .theme-toggle {
          width: 100%;
        }

        .theme-toggle {
          justify-content: space-between;
        }
      }

      @media (max-width: 420px) {
        .brand {
          align-items: flex-start;
        }

        .brand-mark {
          width: 40px;
          height: 40px;
        }

        .hero h2 {
          font-size: 1.75rem;
        }

        .badge,
        .mdx-head code {
          white-space: normal;
          word-break: break-word;
        }
      }
    
      .manager {
        grid-column: 1 / -1;
      }
      .posts-table-wrapper {
        margin-top: 1rem;
        overflow-x: auto;
      }
      .posts-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        text-align: left;
      }
      .posts-table th, .posts-table td {
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
      }
      .posts-table th {
        color: var(--muted);
        font-weight: 500;
        text-transform: uppercase;
        font-size: 11px;
      }
      .posts-table tr:hover {
        background: var(--surface-soft);
      }
      .action-btns {
        display: flex;
        gap: 6px;
      }
      .action-btn {
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        border: 1px solid var(--border);
        background: var(--surface);
        cursor: pointer;
      }
      .action-btn:hover {
        background: var(--surface-muted);
      }
      .action-btn.del {
        color: var(--danger);
        border-color: var(--danger);
      }

    </style>
  </body>
</html>
