---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PostHead from '@/components/PostHead.astro'
import PostNavigation from '@/components/PostNavigation.astro'
import TOCHeader from '@/components/TOCHeader.astro'
import TOCSidebar from '@/components/TOCSidebar.astro'
import ShareControls from '@/components/ShareControls.astro'
import BookmarkButton from '@/components/BookmarkButton.astro'
import ReadingSettings from '@/components/ReadingSettings.astro'
import RelatedArticles from '@/components/RelatedArticles.astro'
import Newsletter from '@/components/Newsletter.astro'
import Layout from '@/layouts/Layout.astro'
import {
  getAdjacentPosts,
  getAllPostsAndSubposts,
  getPostReadingTime,
  getTOCSections,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getAllPostsAndSubposts()
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }))
}

const post = Astro.props
const currentPostId = Astro.params.id
const { Content, headings } = await render(post)

const postReadingTime = await getPostReadingTime(currentPostId)
const tocSections = await getTOCSections(currentPostId)

const {
  newer: newerPost,
  older: olderPost,
  parent: parentPost,
} = await getAdjacentPosts(currentPostId)

const canonicalUrl = `https://snaxlab.blog/blog/${currentPostId}`
---

<Layout>
  <PostHead slot="head" post={post} />
  <TOCHeader slot="table-of-contents" headings={headings} />

  <section
    class="grid grid-cols-[minmax(0px,1fr)_min(calc(var(--breakpoint-md)-2rem),100%)_minmax(0px,1fr)] gap-y-10 py-8"
  >
    <TOCSidebar sections={tocSections} currentPostId={currentPostId} />

    <div class="col-start-2 flex flex-col gap-y-8">
      <!-- Top Navigation & Controls Row -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <Breadcrumbs
          items={[
            { href: '/blog', label: 'Blog', icon: 'lucide:library-big' },
            {
              href: `/blog/${currentPostId}`,
              label: post.data.title,
              icon: 'lucide:book-open-text',
            },
          ]}
        />

        <div class="flex items-center gap-3">
          <BookmarkButton
            id={post.id}
            title={post.data.title}
            href={`/blog/${post.id}`}
            date={post.data.date.toISOString()}
            description={post.data.description}
          />
          <ReadingSettings />
        </div>
      </div>

      <!-- Article Header -->
      <header class="flex flex-col gap-y-4 text-center pt-2">
        <h1 id="post-title" class="text-3xl leading-tight font-bold break-words sm:text-4xl md:text-5xl tracking-tight">
          {post.data.title}
        </h1>
        <div
          class="text-muted-foreground flex items-center justify-center gap-x-3 text-xs sm:text-sm"
        >
          <time datetime={post.data.date.toISOString()}
            >{formatDate(post.data.date)}</time
          >
          <span>&bull;</span>
          <span>{postReadingTime}</span>
        </div>
      </header>

      <div class="flex items-center justify-between border-y border-border py-2.5">
        <ShareControls title={post.data.title} url={canonicalUrl} />
      </div>

      <!-- Article Content -->
      <article
        class="prose prose-invert prose-headings:scroll-mt-28 prose-p:leading-relaxed max-w-none"
      >
        <Content />
      </article>

      <!-- Bottom Share Controls -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-t border-border pt-6">
        <ShareControls title={post.data.title} url={canonicalUrl} />
        <BookmarkButton
          id={post.id}
          title={post.data.title}
          href={`/blog/${post.id}`}
          date={post.data.date.toISOString()}
          description={post.data.description}
        />
      </div>

      <!-- Related Articles -->
      <RelatedArticles currentPost={post} />

      <!-- Newsletter -->
      <Newsletter />

      <hr class="border-border" />

      <!-- Previous / Next Navigation -->
      <PostNavigation
        newerPost={newerPost}
        olderPost={olderPost}
        parentPost={parentPost}
      />
    </div>
  </section>
</Layout>
