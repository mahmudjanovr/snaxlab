---
import BlogCard from '@/components/BlogCard.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllSeries, getPostById } from '@/lib/data-utils'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const allSeries = await getAllSeries()
  return allSeries.map((s) => ({
    params: { slug: s.id },
    props: { seriesItem: s },
  }))
}

const { seriesItem } = Astro.props
const { Content } = await render(seriesItem)
const { title, description, posts: postIds } = seriesItem.data

const postPromises = postIds.map((id: string) => getPostById(id))
const posts = (await Promise.all(postPromises)).filter(Boolean)
---

<Layout class="max-w-3xl">
  <PageHead
    slot="head"
    title={`${title} (Seriya)`}
    description={description}
  />

  <Breadcrumbs
    items={[
      { href: '/series', label: 'Seriyalar', icon: 'lucide:layers' },
      { label: title, icon: 'lucide:bookmark' },
    ]}
  />

  <header class="flex flex-col gap-y-3 py-4 border-b border-border">
    <span class="text-xs font-semibold uppercase tracking-wider text-primary">
      Mavzuviy seriya ({posts.length} qism)
    </span>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h1>
    <p class="text-sm text-muted-foreground leading-relaxed">{description}</p>
    <div class="prose prose-invert max-w-none text-xs text-foreground/80 pt-2">
      <Content />
    </div>
  </header>

  <section class="mt-8 flex flex-col gap-y-6">
    <h2 class="text-xl font-semibold tracking-tight">Turkumdagi maqolalar ketma-ketligi</h2>
    <div class="flex flex-col gap-4">
      {posts.map((post: any, index: number) => (
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground px-1">
            <span class="size-5 rounded-full bg-primary/10 text-primary flex items-center justify-center font-mono text-[10px]">
              {index + 1}
            </span>
            <span>{index === 0 ? "Boshlang'ich qism" : `${index + 1}-qism`}</span>
          </div>
          <BlogCard entry={post} />
        </div>
      ))}
    </div>
  </section>
</Layout>
