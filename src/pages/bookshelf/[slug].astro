---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Link from '@/components/Link.astro'
import ShareControls from '@/components/ShareControls.astro'
import { Badge } from '@/components/ui/badge'
import Layout from '@/layouts/Layout.astro'
import { getAllBooks, getPostById } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const books = await getAllBooks()
  return books.map((book, index) => ({
    params: { slug: book.id },
    props: {
      book,
      prevBook: index > 0 ? books[index - 1] : null,
      nextBook: index < books.length - 1 ? books[index + 1] : null,
    },
  }))
}

const { book, prevBook, nextBook } = Astro.props
const { Content } = await render(book)
const { title, author, status, rating, genre, dateRead, description, keyIdeas, quotes, relatedPostSlug } = book.data

const relatedPost = relatedPostSlug ? await getPostById(relatedPostSlug) : null
const canonicalUrl = `https://snaxlab.blog/bookshelf/${book.id}`

const statusMap: Record<string, { label: string; variant: 'default' | 'secondary' | 'outline' }> = {
  read: { label: "O'qilgan", variant: 'default' },
  reading: { label: "O'qilmoqda", variant: 'secondary' },
  'want-to-read': { label: 'Rejada', variant: 'outline' },
}
const currentStatus = statusMap[status] || { label: status, variant: 'outline' }
---

<Layout class="max-w-3xl">
  <PageHead
    slot="head"
    title={`${title} — ${author} | Kitob tahlili`}
    description={description}
  />

  <Breadcrumbs
    items={[
      { href: '/bookshelf/', label: 'Kitob javoni', icon: 'lucide:book-open' },
      { label: title, icon: 'lucide:book' },
    ]}
  />

  <article class="flex flex-col gap-y-8 py-6">
    <!-- Header -->
    <header class="flex flex-col gap-y-4 border-b border-border pb-6">
      <div class="flex items-center justify-between gap-2">
        <Badge variant={currentStatus.variant} className="text-xs uppercase tracking-wider">
          {currentStatus.label}
        </Badge>
        {rating && (
          <div class="flex items-center text-amber-500 text-sm" title={`Baho: ${rating}/5`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <Icon
                name="lucide:star"
                class={`size-4 ${i < rating ? 'fill-current' : 'opacity-20'}`}
              />
            ))}
          </div>
        )}
      </div>

      <div class="flex flex-col gap-y-1">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h1>
        <p class="text-lg text-muted-foreground font-medium">Muallif: {author}</p>
      </div>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted-foreground pt-1">
        <span>Janr: <strong class="text-foreground">{genre}</strong></span>
        {dateRead && (
          <>
            <span>&bull;</span>
            <span>O'qilgan sana: <strong class="text-foreground">{formatDate(dateRead)}</strong></span>
          </>
        )}
      </div>

      <div class="pt-2">
        <ShareControls title={`${title} — ${author} kitob tahlili`} url={canonicalUrl} />
      </div>
    </header>

    <!-- Key Ideas -->
    {keyIdeas && keyIdeas.length > 0 && (
      <section class="rounded-xl border border-border bg-secondary/20 p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-primary mb-3 flex items-center gap-1.5">
          <Icon name="lucide:lightbulb" class="size-4" />
          Asosiy g'oyalar va tezislar
        </h2>
        <ul class="flex flex-col gap-y-2 text-sm text-foreground/90 list-disc list-inside">
          {keyIdeas.map((idea: string) => (
            <li class="leading-relaxed">{idea}</li>
          ))}
        </ul>
      </section>
    )}

    <!-- Editorial Review Content -->
    <section class="prose prose-invert max-w-none leading-relaxed">
      <h2 class="text-xl font-semibold mb-3">Shaxsiy tahlil va taassurotlar</h2>
      <Content />
    </section>

    <!-- Selected Quotes -->
    {quotes && quotes.length > 0 && (
      <section class="flex flex-col gap-y-4 border-t border-border pt-6">
        <h2 class="text-lg font-semibold flex items-center gap-2">
          <Icon name="lucide:quote" class="size-4 text-primary" />
          Kitobdan saralangan iqtiboslar
        </h2>
        <div class="flex flex-col gap-y-3">
          {quotes.map((q: any) => (
            <blockquote class="border-l-2 border-primary/50 bg-secondary/20 px-4 py-3 rounded-r-lg text-sm italic text-foreground/90">
              <p>"{q.quote}"</p>
              {q.page && (
                <footer class="text-right text-xs text-muted-foreground not-italic mt-1">
                  — {q.page}-sahifa
                </footer>
              )}
            </blockquote>
          ))}
        </div>
      </section>
    )}

    <!-- Related Post Connection -->
    {relatedPost && (
      <section class="rounded-xl border border-border bg-secondary/30 p-5 flex flex-col gap-y-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          Bog'liq blog maqolasi
        </span>
        <h3 class="text-base font-semibold">
          <Link href={`/blog/${relatedPost.id}/`} class="hover:underline flex items-center gap-1.5">
            {relatedPost.data.title} &rarr;
          </Link>
        </h3>
        {relatedPost.data.description && (
          <p class="text-xs text-muted-foreground">{relatedPost.data.description}</p>
        )}
      </section>
    )}

    <!-- Next / Prev Book Navigation -->
    <nav class="flex items-center justify-between border-t border-border pt-6 text-xs font-medium">
      {prevBook ? (
        <Link href={`/bookshelf/${prevBook.id}/`} class="hover:underline flex items-center gap-1">
          &larr; {prevBook.data.title}
        </Link>
      ) : <span />}

      {nextBook ? (
        <Link href={`/bookshelf/${nextBook.id}/`} class="hover:underline flex items-center gap-1">
          {nextBook.data.title} &rarr;
        </Link>
      ) : <span />}
    </nav>
  </article>
</Layout>
