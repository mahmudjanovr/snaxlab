---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Link from '@/components/Link.astro'
import Layout from '@/layouts/Layout.astro'
import { getArchiveByYearAndMonth, getAllPosts } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'

const archive = await getArchiveByYearAndMonth()
const totalPosts = (await getAllPosts()).length
const years = Object.keys(archive).sort((a, b) => parseInt(b) - parseInt(a))
---

<Layout class="max-w-3xl">
  <PageHead
    slot="head"
    title="Xronologik maqolalar arxivi"
    description="SnaxLab barcha maqolalarining yillar va oylar bo'yicha tartiblangan to'liq xronologik arxivi."
  />

  <Breadcrumbs items={[{ label: 'Arxiv', icon: 'lucide:archive' }]} />

  <section class="flex flex-col gap-y-3">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold tracking-tight">Xronologik arxiv</h1>
      <span class="rounded-full border border-border bg-secondary/50 px-3 py-1 text-xs font-semibold">
        Jami {totalPosts} ta maqola
      </span>
    </div>
    <p class="text-muted-foreground text-sm leading-relaxed">
      Blogda e'lon qilingan barcha yozuvlarning vaqt bo'yicha to'liq retrospektivasi.
    </p>
  </section>

  <div class="mt-10 flex flex-col gap-y-12">
    {
      years.map((year) => {
        const yearData = archive[year]
        const monthIndices = Object.keys(yearData.months).sort((a, b) => parseInt(b) - parseInt(a))

        return (
          <section class="flex flex-col gap-y-6">
            <div class="flex items-center gap-3 border-b border-border pb-2">
              <h2 class="text-2xl font-bold tracking-tight text-foreground font-mono">
                {year}
              </h2>
              <span class="text-xs text-muted-foreground font-medium">
                ({yearData.total} ta maqola)
              </span>
            </div>

            <div class="flex flex-col gap-y-8 pl-2">
              {monthIndices.map((mIdx) => {
                const month = yearData.months[mIdx]
                return (
                  <div class="flex flex-col gap-y-3">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-primary">
                      {month.monthName}
                    </h3>
                    <ul class="flex flex-col gap-y-2 border-l border-border pl-4" role="list">
                      {month.posts.map((post: any) => (
                        <li class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 text-sm">
                          <Link
                            href={`/blog/${post.id}`}
                            class="hover:underline font-medium text-foreground/90 hover:text-foreground"
                          >
                            {post.data.title}
                          </Link>
                          <time
                            datetime={post.data.date.toISOString()}
                            class="text-xs text-muted-foreground font-mono shrink-0"
                          >
                            {formatDate(post.data.date)}
                          </time>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              })}
            </div>
          </section>
        )
      })
    }
  </div>
</Layout>
