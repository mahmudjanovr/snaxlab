---
import Link from '@/components/Link.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import MobileNav from '@/components/MobileNav.astro'
import { NAV_LINKS, SITE } from '@/consts'
import { Icon } from 'astro-icon/components'
---

<header transition:persist>
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3"
  >
    <Link href="/" class="flex shrink-0 items-center justify-center gap-3 group">
      <img src="/static/logo.svg" alt="SnaxLab Logo" class="size-5 sm:size-6 transition-transform group-hover:scale-105" />
      <span class="hidden h-full text-lg font-medium min-[300px]:block tracking-tight"
        >{SITE.title}</span
      >
    </Link>
    <div class="flex items-center gap-1.5 sm:gap-4">
      <nav class="hidden items-center gap-4 text-sm sm:flex sm:gap-6">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class="text-foreground/70 hover:text-foreground font-medium transition-colors"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <Link
        href="/search"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-md border border-border bg-secondary/30 px-2 py-1 text-xs text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors"
        title="Qidiruv (/)"
        aria-label="Qidiruv sahifasiga o'tish"
      >
        <Icon name="lucide:search" class="size-3.5" />
        <kbd class="font-mono text-[10px] opacity-70">/</kbd>
      </Link>
      <MobileNav />
      <ThemeToggle transition:persist />
    </div>
  </div>
</header>
