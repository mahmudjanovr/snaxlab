---
import { getRelatedPosts, getPostReadingTime } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Badge } from '@/components/ui/badge'
import { Icon } from 'astro-icon/components'
import Link from './Link.astro'

interface Props {
  currentPost: any
}

const { currentPost } = Astro.props
const relatedPosts = await getRelatedPosts(currentPost, 3)
---

{
  relatedPosts && relatedPosts.length > 0 && (
    <section class="mt-12 flex flex-col gap-y-6 pt-8 border-t border-border">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-medium tracking-tight">O'xshash maqolalar</h2>
        <span class="text-xs text-muted-foreground">Mavzuviy tavsiyalar</span>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {relatedPosts.map(async (post) => {
          const readTime = await getPostReadingTime(post.id)
          return (
            <article class="group relative flex flex-col justify-between rounded-xl border border-border p-4 transition-colors duration-200 hover:bg-secondary/40">
              <div class="flex flex-col gap-y-2">
                <div class="text-muted-foreground text-[11px]">
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                  <span> • </span>
                  <span>{readTime}</span>
                </div>
                <h3 class="text-sm font-semibold leading-snug group-hover:text-primary transition-colors">
                  <Link href={`/blog/${post.id}`} class="outline-none">
                    <span class="absolute inset-0" aria-hidden="true" />
                    {post.data.title}
                  </Link>
                </h3>
                {post.data.description && (
                  <p class="text-muted-foreground text-xs line-clamp-2">
                    {post.data.description}
                  </p>
                )}
              </div>

              {post.data.tags && post.data.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {post.data.tags.slice(0, 2).map((tag: string) => (
                    <Badge variant="secondary" className="text-[10px] py-0 px-1.5">
                      <Icon name="lucide:hash" class="size-2.5 mr-0.5" />
                      {tag}
                    </Badge>
                  ))}
                </div>
              )}
            </article>
          )
        })}
      </div>
    </section>
  )
}
